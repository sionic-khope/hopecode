{
  "name": "hopecode",
  "productName": "Hopecode",
  "version": "0.1.0",
  "description": "Native macOS chat UI for Claude Code sessions with multi-account rotation",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Hopecode",
  "license": "UNLICENSED",
  "scripts": {
    "predev": "node scripts/build-codex-acp.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/build-codex-acp.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "pretest": "node scripts/build-codex-acp.mjs",
    "test": "vitest run",
    "pretest:e2e": "node scripts/build-codex-acp.mjs",
    "test:e2e": "playwright test",
    "predist:dir": "node scripts/build-codex-acp.mjs --fresh",
    "dist:dir": "electron-vite build && electron-builder --mac --dir",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "presmoke:native": "node scripts/build-codex-acp.mjs",
    "smoke:native": "electron-vite build && node scripts/smoke-native.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:codex-acp": "node scripts/build-codex-acp.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.282",
    "node-pty": "1.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@agentclientprotocol/codex-acp": "2.1.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@electron/rebuild": "4.2.0",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.7.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "bun": "1.4.2",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false,
    "bun@1.4.2": true
  }
}
